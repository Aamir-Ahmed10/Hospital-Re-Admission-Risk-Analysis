	CAST((COUNT(*) - COUNT(weight)) * 100.0 / COUNT(*) AS DECIMAL(5,1)) AS percent_missing_weight,
	CAST((COUNT(*) - COUNT(payer_code)) * 100.0 / COUNT(*) AS DECIMAL(5,1)) AS percent_missing_payer_code,
	CAST((COUNT(*) - COUNT(medical_specialty)) * 100.0 / COUNT(*) AS DECIMAL(5,1)) AS percent_missing_specialty
